/**
 * @file @ModelName@_mass_eigenstates_landau_gauge.cpp
 * @brief implementation of the @ModelName@ model class with tree-level
 *        masses and mixings in the Landau gauge
 *
 * This file was generated with FlexibleSUSY @FlexibleSUSYVersion@ and SARAH @SARAHVersion@ .
 */

#include "@ModelName@_mass_eigenstates_landau_gauge.hpp"
#include "config.h"
#include "eigen_utils.hpp"
#include "error.hpp"
#include "linalg2.hpp"
#include "wrappers.hpp"

namespace flexiblesusy {

#define CLASSNAME @ModelName@_mass_eigenstates_landau_gauge

CLASSNAME::CLASSNAME(const @ModelName@_mass_eigenstates& model)
   : @ModelName@_mass_eigenstates(model.get_input())
{
   // copy the running parameters only: the pole masses and problems of
   // the given model may be written concurrently by other threads
   // during the parallel pole mass calculation
   @ModelName@_soft_parameters::operator=(model);

   // As in SARAH/SPheno, the tree-level EWSB eqs. are solved with the
   // full gauge couplings (for the same parameters as in
   // calculate_DRbar_masses() of the given model) ...
@solveEWSBTreeLevel@

   // ... and only then the gaugeless limit is taken, in which the
   // SARAH 2-loop diagrams are derived.  The EWSB eqs. are not solved
   // again, so the tree-level tadpoles do not vanish in the gaugeless
   // limit, and the Goldstone bosons are not massless in general.
@setGaugelessLimit@

   // re-calculate all tree-level masses and mixings, now using the
   // Landau gauge versions of the gauge dependent ones, without
   // solving the EWSB eqs. (unlike calculate_DRbar_masses())
@calculateAllMasses@
}

@massCalculationFunctions@

} // namespace flexiblesusy
