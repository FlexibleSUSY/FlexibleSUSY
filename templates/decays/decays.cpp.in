namespace {
double get_lepton_masses(const context_base& context, const softsusy::QedQcd& qedqcd, int idx) {
   switch (idx) {
      case 0:
         return qedqcd.displayMass(softsusy::mElectron);
      case 1:
         return qedqcd.displayMass(softsusy::mMuon);
      case 2:
         return qedqcd.displayMass(softsusy::mTau);
      default:
         return context.physical_mass<ChargedLepton>({idx});
   }
}
} // anonymous namespace

template <typename F>
std::complex<double> subtract_1l_QED_triangle(
   @ModelName@_cxx_diagrams::context_base const& context, typename field_indices<F>::type const& idxIn, int idxOut1, int idxOut2, double mL1OS, double mL2OS)
{
      auto& lib = Loop_library::get();
      looplibrary::Bcoeff_t B_coeffs;
      looplibrary::Ccoeff_t C_coeffs;

      const double mHOS = context.physical_mass<F>(idxIn);
      const double mL1Tree = context.mass<ChargedLepton>({idxOut1});
      const double mL2Tree = context.mass<ChargedLepton>({idxOut2});

      // B,C functions for triangle diagram, evaluated at physical and tree masses
      lib.B(B_coeffs, Sqr(mL1OS), 0, Sqr(mL1Tree), Sqr(mHOS));
      lib.C(C_coeffs, Sqr(mL1OS), Sqr(mL2OS), Sqr(mHOS), Sqr(mL1Tree), 0, Sqr(mL2Tree), Sqr(mHOS));

      const auto b0 = B_coeffs.at(0);
      const auto c0 = C_coeffs.at(0);
      const auto c1 = C_coeffs.at(1);
      const auto c2 = C_coeffs.at(2);

      const auto charge = unit_charge(context);

      const auto gamma_triangle = oneOver16PiSqr * Sqr(charge) * (-2) * (-1 + 2 * b0
                                 + c0 * mL1Tree * (2 * mL1Tree + 2 * mL2Tree + mL1OS - mL2OS)
                                 + c1 * (Sqr(mHOS) + mL1OS * (mL1Tree + mL2Tree) + Sqr(mL1OS) - Sqr(mL2OS))
                                 + c2 * (2 * Sqr(mHOS) + (mL1Tree + mL2Tree) * (mL1OS - mL2OS)));

      return gamma_triangle;
}

std::array<std::complex<double>, 3> subtract_1l_QED_se(
   @ModelName@_cxx_diagrams::context_base const&  context, int idx, double scale, double mL1OS)
{
      auto& lib = Loop_library::get();
      looplibrary::Bcoeff_t B_coeffs;

      const double mL1Tree = context.mass<ChargedLepton>({idx});

      lib.B(B_coeffs, Sqr(mL1OS), 0, Sqr(mL1Tree), Sqr(scale));
      const auto b0 = B_coeffs.at(0);
      const auto b1 = B_coeffs.at(1);

      const auto charge = unit_charge(context);

      const auto gamma_se_PL = oneOver16PiSqr * Sqr(charge) * (2 * b0 + 2 * b1 - 1);
      const auto gamma_se_PR = oneOver16PiSqr * Sqr(charge) * (2 * b0 + 2 * b1 - 1);
      const auto gamma_se_1 = oneOver16PiSqr * Sqr(charge) * (-2) * (2 * b0 - 1) * mL1Tree;

      return {gamma_se_1, gamma_se_PL, gamma_se_PR};
}

std::array<std::complex<double>, 3> subtract_1l_QED_se_deriv(
   @ModelName@_cxx_diagrams::context_base const&  context, int idx, double scale, double mLOS)
{
      auto& lib = Loop_library::get();
      looplibrary::Bcoeff_t B_coeffs;

      const double mLTree = context.mass<ChargedLepton>({idx});

      const auto db0 = lib.DB0(Sqr(mLOS), 0, Sqr(mLTree), Sqr(scale));
      const auto db1 = lib.DB1(Sqr(mLOS), 0, Sqr(mLTree), Sqr(scale));

      const auto charge = unit_charge(context);

      const auto gamma_se_PL = oneOver16PiSqr * Sqr(charge) * (2 * db0 + 2 * db1);
      const auto gamma_se_PR = oneOver16PiSqr * Sqr(charge) * (2 * db0 + 2 * db1);
      const auto gamma_se_1 = oneOver16PiSqr * Sqr(charge) * (-2) * (2 * db0) * mLTree;

      return {gamma_se_1, gamma_se_PL, gamma_se_PR};
}

void CLASSNAME::clear_problems()
{
   problems.clear();
}

void CLASSNAME::clear()
{
   clear_problems();
   decay_table.clear();
}

void CLASSNAME::calculate_decays()
{
try {
#ifdef ENABLE_THREADS
@callAllDecaysFunctionsInThreads@
#else
@callAllDecaysFunctions@
#endif
}
catch (std::exception& e) {
   problems.add_error(e.what());
}
}

double CLASSNAME::get_alphas(@ModelName@_cxx_diagrams::context_base const&  context) const
{
   return Sqr(context.model.get_@gs_name@())/(4.*Pi);
}

double CLASSNAME::get_alpha(@ModelName@_cxx_diagrams::context_base const&  context) const
{
   return Sqr(unit_charge(context))/(4.*Pi);
}

/* 1-loop BSM amplitudes
 *
 * Notes:
 *    - Since FS removes a factor of i from every vertex we reintroduce it
 *      calls to one loop amplitudes
 */

template <int N>
constexpr auto _to_array = [](auto&& ...x) {
   return std::array<int, N>{std::forward<decltype(x)>(x)...};
};

template <typename Field>
int fieldPDG(const typename field_indices<Field>::type indx) {
   return boost::hana::unpack(Field::pdgids, _to_array<boost::hana::size(Field::pdgids)>).at(indx.size() > 0 ? indx.at(0) : 0);
}

@calcAmplitudeSpecializationDefs@

// -------- specializations for decays needing higher order SM corrections --------

@create_BSM_particle_list@

template <typename DecayProds, typename V>
bool check_3body_Vff_decay(const context_base& context, double  mHOS, const typename field_indices<V>::type& idx)  {
   bool found_problem = false;
   const double mVOS {context.physical_mass<V>(idx)};
   boost::mpl::for_each<DecayProds>(
      [mHOS, mVOS, &idx, &context, &found_problem](auto arg) {
         using T = decltype(arg);
         using Field1 = typename boost::mpl::at<T, boost::mpl::int_<0>>::type;
         using Field2 = typename boost::mpl::at<T, boost::mpl::int_<1>>::type;
         using vertexId1 = Vertex<V, Field1, Field2>;
         for (const auto& indexId1: index_range<vertexId1>()) {
            const auto externalFieldIndicesIn1 = vertexId1::template indices_of_field<0>(indexId1);
            if (externalFieldIndicesIn1 != idx) {
               continue;
            }
            const auto externalFieldIndicesIn2 = vertexId1::template indices_of_field<1>(indexId1);
            const auto externalFieldIndicesIn3 = vertexId1::template indices_of_field<2>(indexId1);

            const double mInternal2 {context.physical_mass<Field1>(externalFieldIndicesIn2)};
            const double mInternal3 {context.physical_mass<Field2>(externalFieldIndicesIn3)};

            if (mHOS-mVOS > mInternal2 + mInternal3
                && !Vertex<V, Field1, Field2>::evaluate(indexId1, context).isZero()) {
               found_problem = true;
            }
         }
      }
   );
   return found_problem;
}

