#ifndef @ModelName@_MASS_EIGENSTATES_LANDAU_GAUGE_H
#define @ModelName@_MASS_EIGENSTATES_LANDAU_GAUGE_H

#include "@ModelName@_mass_eigenstates.hpp"

#include <Eigen/Core>

namespace flexiblesusy {

/**
 * @class @ModelName@_mass_eigenstates_landau_gauge
 * @brief model class with tree-level masses and mixings in the Landau gauge
 *
 * Copy of a given model in the gaugeless limit, i.e. with the gauge
 * couplings of the gauge groups broken by EWSB set to zero, where
 * the tree-level masses and mixings are re-calculated with the gauge
 * dependent ones (e.g. those of the Goldstone bosons) in the Landau
 * gauge (xi = 0).  As in the given model, the tree-level masses are
 * calculated at the tree-level minimum, so the Goldstone bosons are
 * massless.  It is used to evaluate the auto-generated 2-loop
 * tadpoles and self-energies, which are derived in the gaugeless
 * limit and in the Landau gauge.
 */
class @ModelName@_mass_eigenstates_landau_gauge : public @ModelName@_mass_eigenstates
{
public:
   explicit @ModelName@_mass_eigenstates_landau_gauge(const @ModelName@_mass_eigenstates&);
   @ModelName@_mass_eigenstates_landau_gauge(const @ModelName@_mass_eigenstates_landau_gauge&) = default;
   @ModelName@_mass_eigenstates_landau_gauge(@ModelName@_mass_eigenstates_landau_gauge&&) = default;
   virtual ~@ModelName@_mass_eigenstates_landau_gauge() = default;
   @ModelName@_mass_eigenstates_landau_gauge& operator=(const @ModelName@_mass_eigenstates_landau_gauge&) = default;
   @ModelName@_mass_eigenstates_landau_gauge& operator=(@ModelName@_mass_eigenstates_landau_gauge&&) = default;

   // gauge dependent tree-level masses and mixings
@massCalculationPrototypes@
};

} // namespace flexiblesusy

