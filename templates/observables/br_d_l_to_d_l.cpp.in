/// number of four-fermion operators: S_XY (4), V_XY (4), T_XX (2)
constexpr int number_of_operators = 10;

using Operators = Eigen::Array<std::complex<double>, number_of_operators, 1>;

/// entries of the result: the Wilson coefficients in the flavio basis
enum Coefficient : int {
   dummy, C7, C7p, C8, C8p, C9, C9p, C10, C10p, CS, CSp, CP, CPp,
   number_of_results
};

using Result = Eigen::Array<std::complex<double>, number_of_results, 1>;

std::valarray<std::complex<double>> zero(
   int /* generationIndex1 */,
   int /* generationIndex2 */,
   const @ModelName@_mass_eigenstates&,
   bool){
   std::valarray<std::complex<double>> res {0.0, 0.0, 0.0, 0.0};
   return res;
}

/**
 * @brief Converts the coefficients of the effective Lagrangian into the
 *        Wilson coefficients of the flavio basis of the weak effective
 *        theory [https://wcxf.github.io/assets/pdf/WET.flavio.pdf] (the
 *        same normalization as in SuperIso and the FLHA [1008.0762]):
 *
 *    L = N sum_i C_i O_i,  N = 4 G_F/sqrt(2) V_tb V_tq^*,
 *    O_7  = e/(16 Pi^2) m_b (qbar sigma^munu P_R b) F_munu,
 *    O_8  = g_s/(16 Pi^2) m_b (qbar sigma^munu T^a P_R b) G^a_munu,
 *    O_9  = e^2/(16 Pi^2) (qbar gamma^mu P_L b)(lbar gamma_mu l),
 *    O_10 = e^2/(16 Pi^2) (qbar gamma^mu P_L b)(lbar gamma_mu gamma_5 l),
 *    O_S  = e^2/(16 Pi^2) m_b (qbar P_R b)(lbar l),
 *    O_P  = e^2/(16 Pi^2) m_b (qbar P_R b)(lbar gamma_5 l),
 *
 * and the primed operators with P_L <-> P_R in the quark current (q = s,
 * d; for other transitions V_tb V_tq^* is replaced by V_t,in V_t,out^*).
 * The tensor operators are not part of this basis.
 *
 * @param DL, DR coefficients of m_b (qbar sigma^munu P_{L,R} b) F_munu
 * @param GL, GR coefficients of m_b (qbar sigma^munu T^a P_{L,R} b) G^a_munu
 * @param CXY coefficients of the four-fermion operators [3 X 1][4 Y 2]
 * @param mb mass of the incoming quark
 * @param e electric charge
 * @param gs strong coupling
 * @param dIn generation index of the incoming quark
 * @param dOut generation index of the outgoing quark
 * @param qedqcd low-energy data (G_F and CKM matrix)
 *
 * @return Wilson coefficients (0 if V_t,in V_t,out^* vanishes)
 */
Result to_flavio_basis(
   std::complex<double> DL, std::complex<double> DR,
   std::complex<double> GL, std::complex<double> GR,
   const Operators& CXY, double mb, double e, double gs,
   int dIn, int dOut, const softsusy::QedQcd& qedqcd)
{
   Result res = Result::Zero();

   const auto ckm = qedqcd.get_complex_ckm();
   const std::complex<double> lambda = ckm(2, dIn) * Conj(ckm(2, dOut));
   const auto N = 4.*qedqcd.displayFermiConstant()/Sqrt(2.) * lambda;

   if (is_zero(std::abs(N))) {
      WARNING("@namespace@: V_t" << dIn << " V_t" << dOut
              << "^* = 0, the Wilson coefficients are set to zero.");
      return res;
   }

   const auto N7 = N * e * oneOver16PiSqr;
   const auto N8 = N * gs * oneOver16PiSqr;
   const auto N9 = N * Sqr(e) * oneOver16PiSqr;

   res[C7]   = DR/N7;
   res[C7p]  = DL/N7;
   res[C8]   = GR/N8;
   res[C8p]  = GL/N8;
   res[C9]   = (CXY[5] + CXY[4])/(2.*N9);
   res[C9p]  = (CXY[7] + CXY[6])/(2.*N9);
   res[C10]  = (CXY[5] - CXY[4])/(2.*N9);
   res[C10p] = (CXY[7] - CXY[6])/(2.*N9);
   res[CS]   = (CXY[3] + CXY[2])/(2.*mb*N9);
   res[CSp]  = (CXY[1] + CXY[0])/(2.*mb*N9);
   res[CP]   = (CXY[3] - CXY[2])/(2.*mb*N9);
   res[CPp]  = (CXY[1] - CXY[0])/(2.*mb*N9);

   return res;
}

/**
 * @brief Writes the Wilson coefficients of the semi-leptonic operators of
 *        b -> s l l or b -> d l l to the json file WC_@ModelName@.json in
 *        the WCxf format [1712.05298] for flavio. The dipole coefficients
 *        C_7 and C_8 are written by the b -> s gamma observable.
 *
 * @param c Wilson coefficients in the flavio basis
 * @param dIn generation index of the incoming quark (2 = b)
 * @param dOut generation index of the outgoing quark (1 = s, 0 = d)
 * @param lep generation index of the leptons
 * @param scale renormalization scale of the coefficients
 */
void write_flavio_json(const Result& c, int dIn, int dOut, int lep, double scale)
{
   if (dIn != 2 || (dOut != 0 && dOut != 1) || lep < 0 || lep > 2) {
      return;
   }

   static const std::array<std::string, 3> quarks = {"d", "s", "b"};
   static const std::array<std::string, 3> leptons = {"ee", "mumu", "tautau"};
   const std::string name = quarks.at(dIn) + quarks.at(dOut) + leptons.at(lep);

   wcxf::update_json_flavio("WC_@ModelName@.json", scale, {
      {"C9_" + name,   c[C9]},
      {"C9p_" + name,  c[C9p]},
      {"C10_" + name,  c[C10]},
      {"C10p_" + name, c[C10p]},
      {"CS_" + name,   c[CS]},
      {"CSp_" + name,  c[CSp]},
      {"CP_" + name,   c[CP]},
      {"CPp_" + name,  c[CPp]}
   });
}

} // anonymous namespace

using namespace @ModelName@_cxx_diagrams;
using namespace @ModelName@_FFV_form_factors;

namespace @namespace@ {

using ffv_function = std::valarray<std::complex<double>> (*)
   (int, int, const @ModelName@_mass_eigenstates&, bool);

using npf_function = std::array<std::complex<double>, number_of_operators> (*)
   (const @ModelName@_mass_eigenstates&, const std::array<int,4>&, const std::array<Eigen::Vector4d,0>&);

/**
 * @tparam    L     Type of a lepton field.
 * @tparam    A     Type of a photon field.
 * @tparam    T     Type of a form factors.
 * @param[in] model Mass eigenstates.
 * @param[in] ff    Quark-photon form factors.
 * @param[in] g     Generation index for leptons.
 * @return Set of four-fermion coefficients from photon penguin amplitudes
 *         (without overall i; with appropriate embedding).
 */
template <class L, class A, class T>
Operators embed_photon(
   const @ModelName@_mass_eigenstates& model, const T& ff, int g) {

   // Get lepton-photon couplings (without i):
   context_base context {model};
   using vertex = Vertex<typename L::lorentz_conjugate, L, A>;
   const auto value =  vertex::evaluate({g, g}, context);
   const auto lL =  value.left();
   const auto lR =  value.right();

   Operators res{};
   // Term from eq. (t.1) will contribute to four-fermion vector coefficients.
   // Minus comes from the form_factors embedding into four-fermion amplitude:
   res[4] = - ff[0] * lL;
   res[5] = - ff[0] * lR;
   res[6] = - ff[1] * lL;
   res[7] = - ff[1] * lR;
   return res;
}

/**
 * @tparam    Name  Function name for npf function.
 * @param[in] model Mass eigenstates.
 * @param[in] in    Generation index for incoming quark.
 * @param[in] out   Generation index for outgoing quark.
 * @param[in] g     Generation index for leptons.
 * @return Set of four-fermion coefficients for amplitudes without photon
 *         penguins (without overall i; with fixed signs for tensor
 *         operators).
 */
template <npf_function Name>
Operators fix_tensors_sign(
   const @ModelName@_mass_eigenstates& model, int in, int out, int g) {
   const auto npf = Name(model,
         std::array<int,4>{in, g, out, g},
         std::array<Eigen::Vector4d, 0>{});
   Operators res(npf.data());
   res[8] = - res[8];
   res[9] = - res[9];
   return res;
}

/**
 * Form factors are defined via the following formula (q = pj - pi > 0; see
 * eq. (3.4) of 1902.06650 (up to electric charge);
 * pi - momenta[going from blob] of outgoing quark,
 * pj - momenta[going into blob] of incoming quark):
 *    <pi, q| T exp(i L_@ModelName@ dx)|pj> =
 *    i * ubari
 *          q^2 gamma_mu (A1_X * P_X)                                  (t.1)
 *          + (zero after embedding term)                              (t.2)
 *          + i mj sigma_munu q^nu (A2_X * P_X)                        (t.3)
 *        uj e^*mu
 * @note Form factors below are ordered as A1_L, A1_R, A2_L, A2_R.
 * @note NPF function returns such result, that G4 = i * npf.
 * @note Match to a low energy effective model with the same covariant derivative
 *       for photon, as in @ModelName@, using eq. (t.3).
 *       Minus comes from the form_factors embedding into four-fermion
 *       amplitude, because we use descending ordering for external fermions
 *          <out:l4,q3| T exp(i L_@ModelName@ dx) |in:l2,q1> =: G4
 * @note For four fermion coefficient matching minus comes from the G4
 *       definition, because
 *          <out:l4,q3| T exp(i L_low dx) |in:l2,q1> = -i * C_XY [3X1]*[4Y2].
 *       The same matching is used for l -> l conversion and l -> 3l (see
 *       2402.14630).
 * @tparam    Down     Type of a down-type quark field.
 * @tparam    Lepton   Type of a lepton field.
 * @tparam    Photon   Type of a photon field.
 * @tparam    photon   Function name for photon form factors.
 * @tparam    gluon    Function name for gluon form factors.
 * @tparam    npf      Function name for npf function.
 * @param[in] dIn      Generation index for incoming quark.
 * @param[in] dOut     Generation index for outgoing quark.
 * @param[in] lInOut   Generation index for leptons.
 * @param[in] model    Mass eigenstates.
 * @param[in] qedqcd   Reference to low-energy data.
 * @return 0 (no observable is calculated) and the new physics Wilson
 *         coefficients C7, C7', C8, C8', C9, C9', C10, C10', CS, CS', CP,
 *         CP' in the flavio basis (see to_flavio_basis()), in the quark
 *         phase convention of the CKM matrix of the low-energy input.
 */
template<class Down, class Lepton, class Photon, ffv_function photon,
         ffv_function gluon, npf_function npf>
Result forge(
   int dIn, int dOut, int lInOut,
   const @ModelName@_mass_eigenstates& model,
   const softsusy::QedQcd& qedqcd) {

   context_base context {model};

   constexpr bool discard_SM_contributions = true;
   const auto form_factors = photon(dIn, dOut, model, discard_SM_contributions);
   const auto form_factors_g = gluon(dIn, dOut, model, discard_SM_contributions);
   const auto photon_l = embed_photon<Lepton, Photon>(model, form_factors, lInOut);
   const auto npf_l = fix_tensors_sign<npf>(model, dIn, dOut, lInOut);

   // The quark field phases of the model's mass eigenstates are arbitrary:
   // convert to the convention of the CKM matrix of the low-energy input.
   const auto phase = ckm_rephasing_phase(@model_ckm@, qedqcd.get_complex_ckm(), dIn, dOut);

   // Matching
   const auto DL = - 0.5 * form_factors[2] * phase;
   const auto DR = - 0.5 * form_factors[3] * phase;
   const auto GL = - 0.5 * form_factors_g[2] * phase;
   const auto GR = - 0.5 * form_factors_g[3] * phase;
   const Operators CXY = (- photon_l - npf_l) * phase;

   const auto res = to_flavio_basis(
      DL, DR, GL, GR, CXY, context.mass<Down>({dIn}), unit_charge(context),
      model.get_@g3@(), dIn, dOut, qedqcd);

   write_flavio_json(res, dIn, dOut, lInOut, model.get_scale());

   return res;
}

