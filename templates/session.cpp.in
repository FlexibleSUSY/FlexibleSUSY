namespace flexiblesusy {
namespace @ModelName@_session_impl {

/******************************************************************/

void Model_data::check_spectrum_pointer() const
{
   if (!spectrum) {
      throw SetupError("No spectrum calculated yet.");
   }
}

/******************************************************************/

@ModelName@_slha_io Model_data::get_slha_io() const
{
   check_spectrum_pointer();
   @ModelName@_slha_io slha_io;

   slha_io.set_settings(settings);
   slha_io.set_sminputs(qedqcd);
   slha_io.set_physical_input(physical_input);
   slha_io.set_modsel(modsel);
   slha_io.set_FlexibleDecay_settings(flexibledecay_settings);
   slha_io.set_input(input);
   @LToLConversion_set_slha@
   slha_io.set_print_imaginary_parts_of_majorana_mixings(
      settings.get(Spectrum_generator_settings::force_positive_masses));

   spectrum->fill_slha_io(slha_io, settings, flexibledecay_settings);

   return slha_io;
}

/******************************************************************/

template <typename Solver_type>
void @ModelName@_spectrum_impl<Solver_type>::calculate_spectrum(
   const Spectrum_generator_settings& settings,
   const SLHA_io::Modsel& modsel,
   const softsusy::QedQcd& qedqcd,
   const @ModelName@_input_parameters& input
)
{
   @ModelName@_spectrum_generator<Solver_type> spectrum_generator;
   spectrum_generator.set_settings(settings);
   spectrum_generator.set_parameter_output_scale(modsel.parameter_output_scale);
   spectrum_generator.run(qedqcd, input);

   models = spectrum_generator.get_models_slha();
   problems = spectrum_generator.get_problems();
   scales.HighScale = spectrum_generator.get_high_scale();
   scales.SUSYScale = spectrum_generator.get_susy_scale();
   scales.LowScale  = spectrum_generator.get_low_scale();
   scales.pole_mass_scale = spectrum_generator.get_pole_mass_scale();
}

/******************************************************************/

template <typename Solver_type>
void @ModelName@_spectrum_impl<Solver_type>::calculate_model_observables(
   const softsusy::QedQcd& qedqcd,
   @LToLConversion_named_argument@
   const Physical_input& physical_input,
   const Spectrum_generator_settings& settings)
{
   observables = calculate_observables(
      std::get<0>(models),
      qedqcd,
      @LToLConversion_class_name@
      physical_input,
      settings,
      scales.pole_mass_scale);
}
@calculateSpectrumDecaysFunction@
@calculateSpectrumDecaysEffCFunction@
/******************************************************************/

template <typename Solver_type>
void @ModelName@_spectrum_impl<Solver_type>::calculate_unitarity() {
   unitarityData = @ModelName@_unitarity::max_scattering_eigenvalue_infinite_s(std::get<0>(models));
}

/******************************************************************/

template <typename Solver_type>
void @ModelName@_spectrum_impl<Solver_type>::fill_slha_io(@ModelName@_slha_io& slha_io,
       const Spectrum_generator_settings& settings, const FlexibleDecay_settings& flexibledecay_settings) const
{
   // problems of the spectrum generator (as in run_@ModelName@.x), which
   // include those of the boundary value problem solver
   const auto force_output = std::get<0>(models).do_force_output();

   slha_io.set_spinfo(problems);
   if (!problems.have_problem() || force_output) {
      slha_io.set_spectrum(models);
      slha_io.set_extra(std::get<0>(models), scales, observables, settings);
   }

   @setUnitarity@
@fillDecaysSLHA@
}

/******************************************************************/

void Model_data::calculate_spectrum()
{
   const int solver_type = static_cast<int>(settings.get(
                                               Spectrum_generator_settings::solver));
   switch (solver_type) {
   case 0:
@runEnabledSolvers@
   default:
      if (solver_type != 0) {
         throw SetupError("invalid solver type");
      }
   }
}

/******************************************************************/

void Model_data::calculate_model_observables()
{
   check_spectrum_pointer();
   spectrum->calculate_model_observables(qedqcd,
      @LToLConversion_class_name@
      physical_input,
      settings);
}
@calculateModelDecaysFunction@
@calculateModelDecaysEffCFunction@
/******************************************************************/

void Model_data::calculate_unitarity()
{
   check_spectrum_pointer();
   spectrum->calculate_unitarity();
}

} // namespace @ModelName@_session_impl

/******************************************************************/
/* @ModelName@_session                                            */
/******************************************************************/

using @ModelName@_session_impl::Model_data;

@ModelName@_session::@ModelName@_session()
   : data(std::make_unique<Model_data>())
{
}

@ModelName@_session::~@ModelName@_session() = default;
@ModelName@_session::@ModelName@_session(@ModelName@_session&&) noexcept = default;
@ModelName@_session& @ModelName@_session::operator=(@ModelName@_session&&) noexcept = default;

void @ModelName@_session::read_slha_input(const std::string& slha_input)
{
   std::istringstream istr(slha_input);
   @ModelName@_slha_io slha_io;
   slha_io.read_from_stream(istr);

   Spectrum_generator_settings settings;
   FlexibleDecay_settings flexibledecay_settings;
   softsusy::QedQcd qedqcd;
   Physical_input physical_input;
   @ModelName@_input_parameters input;
   @LToLConversion_init@

   slha_io.fill(settings);
   slha_io.fill(flexibledecay_settings);
   slha_io.fill(qedqcd);
   slha_io.fill(physical_input);
   slha_io.fill(input);
   @LToLConversion_fill@

   // as run_@ModelName@.x (templates/run.cpp.in)
   if (flexibledecay_settings.get(FlexibleDecay_settings::print_effc_block) &&
       @ModelName@_info::is_CP_violating_Higgs_sector) {
      WARNING("Printing of EFFHIGGSCOUPLINGS block is disabled in models with CP-violating Higgs sector");
      flexibledecay_settings.set(FlexibleDecay_settings::print_effc_block, 0.);
   }

   auto new_data = std::make_unique<Model_data>();
   {
      // named data, as the generated snippet @ LToLConversion_set_data @ expects
      Model_data& data = *new_data;
      data.set_settings(settings);
      data.set_fd_settings(flexibledecay_settings);
      data.set_sm_input_parameters(qedqcd);
      data.set_physical_input(physical_input);
      data.set_input_parameters(input);
      data.set_modsel(slha_io.get_modsel());
      @LToLConversion_set_data@
   }
   data = std::move(new_data);

   spectrum_calculated = false;
   observables_calculated = false;
   decays_calculated = false;
}

void @ModelName@_session::check_spectrum() const
{
   if (!spectrum_calculated) {
      throw SetupError("No spectrum calculated yet.");
   }
}

void @ModelName@_session::calculate_spectrum()
{
   data->calculate_spectrum();
   spectrum_calculated = true;
   observables_calculated = false;
   decays_calculated = false;
}

bool @ModelName@_session::have_spectrum() const
{
   return spectrum_calculated;
}

std::vector<std::string> @ModelName@_session::get_problem_strings() const
{
   check_spectrum();
   return data->get_spectrum().get_problems().get_problem_strings();
}

std::vector<std::string> @ModelName@_session::get_warning_strings() const
{
   check_spectrum();
   return data->get_spectrum().get_problems().get_warning_strings();
}

void @ModelName@_session::calculate_observables()
{
   check_spectrum();
   data->calculate_model_observables();
   observables_calculated = true;
}

bool @ModelName@_session::have_observables() const
{
   return observables_calculated;
}

std::vector<std::string> @ModelName@_session::get_observable_names()
{
   return @ModelName@_observables::get_names();
}

std::vector<double> @ModelName@_session::get_observable_values() const
{
   check_spectrum();
   const auto values = data->get_spectrum().get_observables().get();
   return std::vector<double>(values.data(), values.data() + values.size());
}

std::vector<std::string> @ModelName@_session::get_observable_problem_strings() const
{
   check_spectrum();
   std::vector<std::string> result;
   slha_format_problems_and_warnings(data->get_spectrum().get_observables().problems,
                                     std::back_inserter(result));
   return result;
}

bool @ModelName@_session::has_decays()
{
   return @sessionHasDecays@;
}

void @ModelName@_session::calculate_decays()
{
   check_spectrum();
   if (!has_decays()) {
      throw SetupError("The model @ModelName@ was generated without decays "
                       "(FSCalculateDecays = False).");
   }
   const auto loop_library = Loop_library::get_type();
   if (loop_library != Loop_library::Library::Collier &&
       loop_library != Loop_library::Library::Looptools) {
      throw SetupError("Decays need Collier or LoopTools as loop library "
                       "(FlexibleSUSY[31] = 1 or 2).  The loop library is fixed "
                       "by the first calculation in a process.");
   }
   const auto& settings = data->get_settings();
   if (!settings.get(Spectrum_generator_settings::calculate_sm_masses) ||
       !settings.get(Spectrum_generator_settings::calculate_bsm_masses)) {
      throw SetupError("Decays need SM and BSM pole masses: set FlexibleSUSY[3] = "
                       "FlexibleSUSY[23] = 1 before calculating the spectrum.");
   }
   auto flexibledecay_settings = data->get_fd_settings();
   flexibledecay_settings.set(FlexibleDecay_settings::calculate_decays, 1.0);
   // the decays fill the effective couplings of the neutral Higgs bosons (mass,
   // width, CP, quartic coupling) only with this flag, and HiggsTools and
   // Lilith, which may be called later, need them
   flexibledecay_settings.set(FlexibleDecay_settings::calculate_normalized_effc, 1.0);
   data->set_fd_settings(flexibledecay_settings);
   @sessionCalculateDecays@
   decays_calculated = true;
}

bool @ModelName@_session::have_decays() const
{
   return decays_calculated;
}

std::vector<std::string> @ModelName@_session::get_decay_problem_strings() const
{
   check_spectrum();
   @sessionDecayProblems@
}

std::vector<std::string> @ModelName@_session::get_decay_warning_strings() const
{
   check_spectrum();
   @sessionDecayWarnings@
}

namespace {

@ModelName@_session::Signal_result to_signal_result(const SignalResult& r)
{
   return {r.ndof, r.chi2BSM, r.chi2SM, r.mhRef, r.pval1d, r.pval2d};
}

} // anonymous namespace

bool @ModelName@_session::has_higgstools()
{
#ifdef ENABLE_HIGGSTOOLS
   return true;
#else
   return false;
#endif
}

bool @ModelName@_session::has_lilith()
{
#ifdef ENABLE_LILITH
   return true;
#else
   return false;
#endif
}

void @ModelName@_session::calculate_normalized_effc()
{
   if (!decays_calculated) {
      throw SetupError("HiggsTools and Lilith need the decays: calculate them first.");
   }
   @sessionCalculateEffC@
}

@ModelName@_session::HiggsTools_result @ModelName@_session::call_higgstools(
   const std::string& higgsbounds_dataset, const std::string& higgssignals_dataset)
{
#ifdef ENABLE_HIGGSTOOLS
   check_spectrum();
   if (!std::filesystem::is_directory(higgsbounds_dataset) ||
       !std::filesystem::is_directory(higgssignals_dataset)) {
      throw SetupError("HiggsBounds dataset " + higgsbounds_dataset + " or HiggsSignals "
                       "dataset " + higgssignals_dataset + " is not a directory.");
   }
   calculate_normalized_effc();
   const auto [hs, hb] = flexiblesusy::call_higgstools(
      data->get_normalized_higgs_effc(), data->get_physical_input(),
      higgsbounds_dataset, higgssignals_dataset);
   HiggsTools_result result;
   if (hs.has_value()) {
      result.have_higgssignals = true;
      result.higgssignals = to_signal_result(hs.value());
   }
   for (const auto& [pdg, obs_ratio, exp_ratio, analysis] : hb) {
      result.higgsbounds.push_back({pdg, obs_ratio, exp_ratio, analysis});
   }
   return result;
#else
   throw SetupError("FlexibleSUSY was configured without HiggsTools (--enable-higgstools).");
#endif
}

std::pair<bool, @ModelName@_session::Signal_result> @ModelName@_session::call_lilith(
   const std::string& database)
{
#ifdef ENABLE_LILITH
   check_spectrum();
   // Lilith exits the process if it can't read its database
   if (!std::filesystem::is_regular_file(database)) {
      throw SetupError("Lilith database " + database + " is not a file.");
   }
   calculate_normalized_effc();
   const auto result = flexiblesusy::call_lilith(
      data->get_normalized_higgs_effc(), data->get_physical_input(), database);
   if (!result.has_value()) {
      return {false, {}};
   }
   return {true, to_signal_result(result.value())};
#else
   throw SetupError("FlexibleSUSY was configured without Lilith (--with-lilith).");
#endif
}

std::string @ModelName@_session::get_slha_output() const
{
   check_spectrum();
   std::ostringstream ostr;
   data->get_slha_io().write_to_stream(ostr);
   return ostr.str();
}

int @ModelName@_session::get_loop_library()
{
   // as in FlexibleSUSY[31]; -1: not set yet
   switch (Loop_library::get_type()) {
   case Loop_library::Library::Softsusy: return 0;
   case Loop_library::Library::Collier: return 1;
   case Loop_library::Library::Looptools: return 2;
   case Loop_library::Library::Fflite: return 3;
   default: break;
   }
   return -1;
}

} // namespace flexiblesusy
